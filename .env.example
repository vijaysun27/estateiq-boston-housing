# Flask Application Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production

# Server Configuration
HOST=127.0.0.1
PORT=5000

# Model Paths
