MODEL_PIPELINE_PATH=models/boston_housing_pipeline.joblib
# Option B: Saved Keras ANN Model (from ANN For Regression.ipynb)
KERAS_MODEL_PATH=models/boston_housing_model.keras

# Logging
LOG_LEVEL=INFO
